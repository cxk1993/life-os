{
  "id": "todo",
  "name": "todo",
  "version": "0.1.0",
  "kind": "builtin",
  "minKernel": "0.1.0",
  "kernelApi": "^1",
  "icon": "box",
  "description": "待办与周期清单：散落在 Obsidian 的清单搬进系统，双向同步；支持周期任务、语法糖快速添加、概览统计。",
  "author": "yunxi",
  "window": {
    "w": 720,
    "h": 520
  },
  "entry": "@/apps/todo",
  "api": {
    "base": "/api/v1/todo",
    "openapi": "/api/v1/todo/openapi.json",
    "health": "/api/v1/todo/health"
  },
  "provides": [
    "todo.item.read",
    "todo.item.write"
  ],
  "requires": [],
  "slots": [
    "dashboard.card",
    "window.sidecar",
    "desktop.dock-right"
  ],
  "emits": [
    "todo.item.created",
    "todo.item.updated",
    "todo.item.completed"
  ],
  "consumes": [],
  "permissions": [
    "db:own"
  ],
  "migrations": "api/migrations",
  "settingsSchema": "api/settings.schema.json",
  "lifecycle": {
    "onInstall": null,
    "onEnable": null,
    "onDisable": null,
    "onUninstall": null
  }
}
