{
  "id": "health",
  "name": "健康",
  "version": "0.1.0",
  "kind": "builtin",
  "minKernel": "0.1.0",
  "kernelApi": "^1",
  "icon": "box",
  "description": "症状/用药/复诊/体检记录，需跟进时经事件总线联动待办",
  "author": "yunxi",
  "window": {
    "w": 800,
    "h": 580,
    "minW": 480,
    "minH": 360,
    "singleton": false
  },
  "entry": "@/apps/health",
