# ── 密钥与本地配置（★ 最重要的一条：.env 绝不进仓库）──
.env
.env.*
!.env.example

# ── 数据（迁移 = 复制这个目录）──
data/
*.db
*.db-wal
*.db-shm

# ── 前端 ──
node_modules/
dist/
.vite/
*.local

# ── Python ──
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── 日志与临时文件 ──
*.log
logs/
tmp/
.DS_Store
Thumbs.db

# vite 每次加载 vite.config.ts 都会生成的临时副本（每次 make verify 都会刷新，
# 不清掉的话会不停挤进 git status —— 实测漏了 10 个进来）
apps/web/vite.config.ts.timestamp-*.mjs

# Windows 保留设备名，git 无法索引（Git Bash 下 ">nul" 产生）
nul

# ── 本机桥 / frp 本地文件（含 PSK、token，绝不入库）──
services/bridge/start-bridge.cmd
services/bridge/*.err
deploy/tools/frp/frpc.toml
deploy/tools/frp/*.bak*
deploy/tools/frp/start-frpc.cmd
deploy/tools/frp/*.log
deploy/tools/frp/*.err
deploy/tools/frp/frpc-out.txt
deploy/tools/nssm/*
!deploy/tools/nssm/install-services.ps1
!deploy/tools/nssm/install-services.cmd
deploy/tools/**/*.exe
.workbuddy/
